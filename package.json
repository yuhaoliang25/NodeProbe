{
  "name": "free-node-filter",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "discover": "node scripts/discover-sources.js",
    "fetch": "node scripts/fetch-sources.js",
    "build": "node scripts/build-subscriptions.js && node scripts/convert-subscriptions.js",
    "geo": "node scripts/detect-ip-country.js",
    "source-graph": "node scripts/analyze-source-graph.js",
    "node-pool": "node scripts/update-node-pool.js",
    "node-index": "node scripts/generate-node-index.js",
    "best-audit": "node scripts/generate-best-audit.js",
    "stability": "node scripts/confirm-stability.js",
    "check": "node --check scripts/*.js",
    "lint": "npx --yes eslint@8 --no-eslintrc --env node --env es6 --parser-options '{\"ecmaVersion\":2022}' --rule 'no-undef:error' scripts/*.js",
    "client-config": "node scripts/generate-client-config.js",
    "china-assets": "node scripts/china-node-asset.js",
    "china-apply": "node scripts/apply-china-observations.js",
    "china-probe": "node scripts/china-probe.js"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  }
}
